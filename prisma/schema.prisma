// PAYNORA AI — Prisma schema.
//
// Phase 1 introduces the identity and multi-tenancy foundation: User,
// Organization, and OrganizationMember. See docs/identity-and-tenancy.md
// for the design rationale (auth approach, tenant isolation strategy).
//
// Phase 2 introduces the accounts-receivable core: Customer, Invoice,
// Payment, ActivityEvent. See docs/accounts-receivable.md for the money
// representation, currency model, invoice lifecycle, and concurrency
// strategy — those decisions shape several choices below that aren't
// self-explanatory from the schema alone (e.g. why outstanding/paid amounts
// are not columns here).
//
// Phase 3 introduces the Operator foundation: BusinessEvent, OperatorInsight,
// ActionProposal. See docs/operator-foundation.md for the pipeline design.
// These models never store financial facts of their own — amounts, dates,
// and status are always read live from Invoice/Payment via the Phase 2
// functions and only *referenced* here (invoiceId, customerId) or copied
// into a JSON snapshot for audit purposes. AI never writes to this schema
// directly; every row here is created by deterministic server code.
//
// Phase 4 introduces Communications Foundation + Email Execution:
// Communication, DeliveryAttempt. See docs/communications.md for the
// lifecycle, delivery semantics, and idempotency strategy. A Communication
// is always tied 1:1 to the ActionProposal it was drafted for; sending one
// is a distinct, explicit step from approving the proposal it came from.
//
// Phase 5 introduces Collections Automation: CollectionPolicy,
// CollectionPolicyStep, CollectionSequence, CollectionStepExecution. See
// docs/collections-automation.md for the full design (scheduling, catch-up,
// concurrency, and the payment/cancellation/UNCERTAIN races). This layer
// never sends anything itself and never invents a second Operator or email
// pipeline — it only ever drives the existing BusinessEvent -> OperatorInsight
// -> ActionProposal -> Communication chain from Phases 3-4, on a schedule
// instead of only on manual detection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                  OrganizationMember[]
  decidedActionProposals       ActionProposal[]
  autoSendEnabledPolicies      CollectionPolicy[]
  passwordResetTokens          PasswordResetToken[]
  sentInvitations              OrganizationInvitation[] @relation("InvitedBy")
  acceptedInvitations          OrganizationInvitation[] @relation("AcceptedBy")
  createdCryptoPaymentRequests CryptoPaymentRequest[]

  @@map("users")
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  // Phase 5 global kill switch. Automation is OFF by default for every
  // organization, including newly created ones — see
  // docs/collections-automation.md#kill-switch. Flipping this to true does
  // not by itself send anything: it only allows runAutomationTick to look
  // at this org's enabled CollectionPolicy/CollectionSequence rows at all.
  automationEnabled    Boolean   @default(false)
  // Phase 9: the scheduler's fair-rotation cursor — see
  // src/server/collections/engine.ts#resolveTargetOrganizationIds and
  // docs/audits/PAYNORA-AUDIT-V1-REMEDIATION.md P1-5. Null means "never
  // processed," which sorts first (highest priority) alongside genuinely
  // stale organizations. Updated after an org is processed in a tick,
  // regardless of that org's own success/failure, so one broken
  // organization never blocks others from rotating through.
  automationLastTickAt DateTime?
  // Phase 15A: per-organization analytics opt-out (Settings -> Privacy).
  // Defaults to true so existing deployments' analytics behavior is
  // unchanged by this column's addition — the real on/off switch remains
  // ANALYTICS_PROVIDER (deployment-wide, src/lib/env.ts); this is a
  // second, narrower gate an organization can additionally flip off for
  // itself. See docs/privacy-data-inventory.md#analytics.
  analyticsEnabled     Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  members                  OrganizationMember[]
  customers                Customer[]
  invoices                 Invoice[]
  payments                 Payment[]
  activityEvents           ActivityEvent[]
  businessEvents           BusinessEvent[]
  operatorInsights         OperatorInsight[]
  actionProposals          ActionProposal[]
  communications           Communication[]
  deliveryAttempts         DeliveryAttempt[]
  collectionPolicies       CollectionPolicy[]
  collectionSequences      CollectionSequence[]
  collectionStepExecutions CollectionStepExecution[]
  invitations              OrganizationInvitation[]
  subscription             OrganizationSubscription?
  wallets                  Wallet[]
  cryptoPaymentRequests    CryptoPaymentRequest[]
  walletTransactions       WalletTransaction[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

// Phase 11.2: account recovery + organization member invitations. See
// docs/account-recovery-and-invitations.md. Both token types follow the
// same "never store the secret itself" principle as User.passwordHash: only
// a SHA-256 digest of the token the requester actually holds (the one in
// the emailed link) is persisted. Expiration and single-use are enforced in
// the domain layer (src/server/auth/password-reset.ts,
// src/server/tenancy/invitations.ts) by checking expiresAt/consumedAt or
// status at read time — not by any database-level TTL.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  // Null while usable; set the instant the token is consumed, so a reused
  // token fails safely (see resetPassword's single-use check) instead of
  // relying solely on deleting the row.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model OrganizationInvitation {
  id               String           @id @default(cuid())
  organizationId   String
  // Normalized (lowercased/trimmed) the same way User.email is — see
  // src/server/auth/email.ts's normalizeEmail, reused here.
  email            String
  role             OrganizationRole
  tokenHash        String           @unique
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  invitedByUserId  String
  acceptedAt       DateTime?
  // Set only once accepted; deliberately nullable and SetNull on delete —
  // an invitation is a durable audit record of "who was invited", and
  // losing track of who invited/accepted must never cascade-delete it.
  acceptedByUserId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy   User?        @relation("AcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  // A per-(organizationId, email) uniqueness constraint restricted to
  // status = 'PENDING' is hand-added in the migration SQL (Prisma has no
  // partial/filtered unique index syntax) — see the migration file and the
  // identical precedent for CollectionPolicy's "one default policy per
  // org" constraint. It backs "no duplicate pending invite for the same
  // organization/email" at the database level, not just in
  // createInvitation's application check.
  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

// Phase 11.3: commercial plans, entitlements, and usage enforcement — see
// docs/billing-entitlements.md. This is PAYNORA's own subscription state
// (what an organization pays PAYNORA), independent of any payment
// provider — no card data, no checkout, no vendor-specific fields beyond
// nullable future integration points (see below). The BillingProvider
// abstraction (src/server/billing/types.ts) already establishes the
// contract a future webhook adapter must fill: verify a vendor event,
// normalize it, and hand it to whatever writes this model — that writer
// does not exist yet (no payment provider is implemented in this phase).
enum PlanId {
  FREE
  STARTER
  PRO
}

// A small, deliberately non-vendor-specific status vocabulary — mirrors
// BillingSubscriptionStatus's normalized values (billing/types.ts) closely
// enough that a future adapter can map 1:1, but this enum is PAYNORA's own
// and never a raw Stripe/YooKassa string. See
// src/server/billing/entitlements.ts#deriveEffectivePlan for exactly how
// each status affects access.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

model OrganizationSubscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  plan                   PlanId             @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  // Nullable future integration points only — populated by a future
  // billing adapter applying a verified webhook event, never by domain
  // code in this phase. See src/server/billing/types.ts's
  // BillingProviderName/BillingCustomerId/BillingSubscriptionId; kept as
  // plain strings here (not FKs, not vendor-typed columns) so this table
  // stays genuinely provider-neutral — AR/AI/Collections code never reads
  // these fields, only `plan`/`status`.
  billingProvider        String?
  externalCustomerId     String?
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_subscriptions")
}

model Customer {
  id                            String                @id @default(cuid())
  organizationId                String
  name                          String
  email                         String?
  phone                         String?
  companyName                   String?
  notes                         String?
  // Phase 8: Telegram chat destination (see docs/communications.md#channel-model).
  // A numeric chat id or "@channelusername" — the same identifier shape
  // MessagingMessage.to already expects. Never itself proof of identity;
  // always resolved server-side from this column, never accepted as
  // client input at send time.
  telegramChatId                String?
  // Phase 8: explicit channel selection when a customer has more than one
  // usable destination configured — see
  // src/server/communications/channel.ts#resolveCommunicationDestination.
  // Null is not "pick one silently"; it only auto-resolves when exactly
  // one destination exists, and requires this to be set explicitly the
  // moment a second one is added.
  preferredCommunicationChannel CommunicationChannel?
  archivedAt                    DateTime?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices            Invoice[]
  activityEvents      ActivityEvent[]
  businessEvents      BusinessEvent[]
  operatorInsights    OperatorInsight[]
  actionProposals     ActionProposal[]
  communications      Communication[]
  collectionSequences CollectionSequence[]

  @@index([organizationId])
  @@index([organizationId, archivedAt])
  @@map("customers")
}

enum InvoiceStatus {
  OPEN
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String
  number         String
  currency       String        @db.Char(3)
  amountMinor    BigInt
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(OPEN)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments              Payment[]
  activityEvents        ActivityEvent[]
  businessEvents        BusinessEvent[]
  operatorInsights      OperatorInsight[]
  actionProposals       ActionProposal[]
  communications        Communication[]
  collectionSequences   CollectionSequence[]
  cryptoPaymentRequests CryptoPaymentRequest[]

  // Invoice numbers are unique per organization, not globally — see
  // docs/accounts-receivable.md#invoice-numbering.
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  // Phase 9: backs listInvoicesWithFinancials's `orderBy: { issueDate: "desc" }`
  // over an organization-scoped query — see docs/audits/PAYNORA-AUDIT-V1.md P1-4.
  @@index([organizationId, issueDate])
  @@index([customerId])
  @@map("invoices")
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  amountMinor    BigInt
  paidAt         DateTime @db.Date
  note           String?
  // Phase 9: client-generated idempotency token — see
  // src/server/ar/payments.ts#recordPayment and
  // docs/audits/PAYNORA-AUDIT-V1-REMEDIATION.md P1-1. Nullable so existing
  // rows (recorded before this column existed) are unaffected; a plain
  // Postgres unique constraint never conflicts across multiple NULLs, so
  // this only starts enforcing dedup once every new payment supplies one
  // (enforced by paymentInputSchema, not by this column being NOT NULL).
  idempotencyKey String?
  createdAt      DateTime @default(now())

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  // Phase 13: set only when this Payment was created by wallet
  // reconciliation rather than manual entry — see
  // docs/wallet-architecture.md#reconciliation. The FK itself lives on
  // WalletTransaction (reconciledPaymentId); this is Prisma's required
  // opposite side of that named relation, not a new column driving any
  // logic of its own.
  walletTransaction WalletTransaction?

  @@unique([invoiceId, idempotencyKey])
  @@index([organizationId])
  @@index([invoiceId])
  // Phase 9: backs listRecentPayments's `orderBy: { createdAt: "desc" }`
  // over an organization-scoped query — see docs/audits/PAYNORA-AUDIT-V1.md P1-4.
  @@index([organizationId, createdAt])
  @@map("payments")
}

enum ActivityEventType {
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  INVOICE_CREATED
  INVOICE_CANCELLED
  PAYMENT_RECORDED
  INVOICE_PAID
  // Phase 3: Operator action-proposal decisions, reusing the same
  // append-only audit trail every other tenant action already uses rather
  // than inventing a parallel one — see docs/operator-foundation.md.
  ACTION_PROPOSAL_APPROVED
  ACTION_PROPOSAL_DISMISSED
  // Phase 4: Communications — see docs/communications.md. Retrying a send
  // reuses COMMUNICATION_SEND_ATTEMPTED (attempt number is in the event's
  // metadata) rather than a separate "retry" type — it's the same kind of
  // fact (an attempt was made) either way.
  COMMUNICATION_PREPARED
  COMMUNICATION_EDITED
  COMMUNICATION_SEND_ATTEMPTED
  COMMUNICATION_SENT
  COMMUNICATION_SEND_FAILED
  ACTION_PROPOSAL_EXECUTED
  // Phase 5: Collections Automation — see docs/collections-automation.md.
  // Deliberately no per-tick "ran automation tick" event: a tick that finds
  // nothing due is not a business fact worth an audit row, and would be
  // pure cron-noise. Only state changes a human would care about are
  // recorded here.
  COLLECTION_POLICY_CREATED
  COLLECTION_POLICY_UPDATED
  AUTOMATION_ENABLED
  AUTOMATION_DISABLED
  COLLECTION_SEQUENCE_STARTED
  COLLECTION_SEQUENCE_PAUSED
  COLLECTION_SEQUENCE_RESUMED
  COLLECTION_SEQUENCE_STOPPED
  COLLECTION_STEP_EXECUTED
  COLLECTION_STEP_SKIPPED
  // Phase 11.2: organization member invitations — see
  // docs/account-recovery-and-invitations.md. Deliberately no
  // password-reset events here: PasswordResetToken has no organizationId
  // (a user can belong to zero or many organizations), so it doesn't fit
  // this tenant-scoped audit trail — see that model's doc comment.
  MEMBER_INVITED
  MEMBER_INVITATION_REVOKED
  MEMBER_JOINED
  // Phase 11.3: commercial plans/entitlements — see
  // docs/billing-entitlements.md. Recorded whenever plan or status
  // actually changes (setOrganizationPlan), never on every quota check —
  // that would be pure noise (see this phase's brief, section 13).
  PLAN_CHANGED
  // Phase 13: Wallet Foundation — see docs/wallet-architecture.md#audit.
  // Exactly the seven safe event kinds that phase calls for; never a
  // private key, seed phrase, provider secret, or auth header in any of
  // these rows' summary/metadata.
  WALLET_CONNECTED
  WALLET_DISCONNECTED
  WALLET_TRANSACTION_DETECTED
  WALLET_TRANSACTION_CONFIRMED
  WALLET_PAYMENT_RECONCILED
  WALLET_RECONCILIATION_REJECTED
  WALLET_WEBHOOK_REJECTED
}

model ActivityEvent {
  id             String            @id @default(cuid())
  organizationId String
  type           ActivityEventType
  summary        String
  metadata       Json?
  customerId     String?
  invoiceId      String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([customerId])
  @@index([invoiceId])
  @@map("activity_events")
}

// --- Phase 3: Operator Foundation --------------------------------------
// event -> insight -> proposal -> human approval. See
// docs/operator-foundation.md for the full pipeline design and
// SECURITY.md for the trust-boundary chain these models sit inside.

enum BusinessEventType {
  // The only detector Phase 3 implements. More event types (payment
  // received, promise broken, ...) are additive in later phases.
  INVOICE_OVERDUE
  // Phase 5: fired by the automation engine when a CollectionSequence's
  // claimed step is ready to become an insight/proposal. Unlike
  // INVOICE_OVERDUE (deduped once per invoice, forever), this is deduped
  // per sequence+step — see docs/collections-automation.md#why-a-new-event-type.
  COLLECTION_STEP_DUE
}

/// A deterministically detected fact about the business — never an AI
/// opinion. `dedupeKey` plus the unique constraint below is what makes the
/// detector idempotent: re-running it for an invoice that's still overdue
/// finds the existing row instead of creating a duplicate. `data` is a
/// point-in-time JSON snapshot of the facts that triggered detection
/// (amounts already formatted to strings — bigint does not survive
/// JSON.stringify), kept for audit/display; it is never re-read as a live
/// financial source — computeInvoiceFinancials is, every time.
model BusinessEvent {
  id             String            @id @default(cuid())
  organizationId String
  type           BusinessEventType
  customerId     String?
  invoiceId      String?
  dedupeKey      String
  data           Json
  detectedAt     DateTime          @default(now())

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer                Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice                 Invoice?                 @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  insights                OperatorInsight[]
  collectionStepExecution CollectionStepExecution?

  @@unique([organizationId, type, dedupeKey])
  @@index([organizationId, type])
  @@index([invoiceId])
  @@map("business_events")
}

enum InsightPriority {
  LOW
  MEDIUM
  HIGH
}

/// A structured interpretation of one BusinessEvent. `priority` is always
/// computed deterministically (see src/server/operator/insights.ts) — AI,
/// when enabled, may only contribute `summary`/`aiTone` display text via a
/// Zod-validated response, never the priority or any financial field.
/// `@@unique([organizationId, businessEventId])` caps this at one insight
/// per event, so re-running the pipeline for an already-processed event is
/// a no-op rather than a duplicate.
model OperatorInsight {
  id              String          @id @default(cuid())
  organizationId  String
  businessEventId String
  customerId      String?
  invoiceId       String?
  priority        InsightPriority
  summary         String
  aiGenerated     Boolean         @default(false)
  aiProvider      String?
  createdAt       DateTime        @default(now())

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessEvent BusinessEvent    @relation(fields: [businessEventId], references: [id], onDelete: Cascade)
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice       Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  proposals     ActionProposal[]

  @@unique([organizationId, businessEventId])
  @@index([organizationId, priority])
  @@map("operator_insights")
}

enum ActionType {
  // The only action type Phase 3 allows. Server-side allowlisted in
  // src/server/operator/proposals.ts — AI output can never introduce a
  // new value here; it isn't asked for one.
  SEND_PAYMENT_REMINDER
}

enum ActionProposalStatus {
  PENDING
  APPROVED
  DISMISSED
  // Reachable starting Phase 4: set only after a Communication's send is
  // *confirmed* successful (src/server/communications/send.ts) — never on
  // approval, and never on an ambiguous/uncertain delivery outcome.
  EXECUTED
  // Deliberately not set by Phase 4. A failed or uncertain send leaves the
  // proposal APPROVED — failure/uncertainty belongs to the Communication
  // and its DeliveryAttempt history (which can be retried), not to the
  // proposal itself. Reserved for a future phase that needs a distinct
  // "this proposal can never be executed" terminal state.
  FAILED
}

/// A proposed action a human must approve before anything happens.
/// Approving this row only flips its status to APPROVED — see
/// src/server/operator/approval.ts. Phase 4 adds the next step: an
/// APPROVED SEND_PAYMENT_REMINDER proposal can have exactly one
/// Communication drafted for it (see the `communication` relation below),
/// and only a *confirmed successful send* of that Communication moves the
/// proposal to EXECUTED — see src/server/communications/send.ts and
/// docs/communications.md. `@@unique` on [organizationId, insightId, type]
/// keeps proposal creation idempotent the same way BusinessEvent/
/// OperatorInsight are.
model ActionProposal {
  id              String               @id @default(cuid())
  organizationId  String
  insightId       String
  customerId      String?
  invoiceId       String?
  type            ActionType
  status          ActionProposalStatus @default(PENDING)
  reasoning       String
  suggestedTone   String?
  decidedAt       DateTime?
  decidedByUserId String?
  createdAt       DateTime             @default(now())

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  insight                 OperatorInsight          @relation(fields: [insightId], references: [id], onDelete: Cascade)
  customer                Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice                 Invoice?                 @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  decidedByUser           User?                    @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  communication           Communication?
  collectionStepExecution CollectionStepExecution?

  @@unique([organizationId, insightId, type])
  @@index([organizationId, status])
  @@map("action_proposals")
}

// --- Phase 4: Communications Foundation + Email Execution ---------------
// Communication drafting/preview/send, and the DeliveryAttempt audit
// trail behind it. See docs/communications.md for the full lifecycle,
// delivery semantics (why there is no exactly-once guarantee and what
// UNCERTAIN means), and idempotency strategy.

enum CommunicationChannel {
  EMAIL
  // Phase 8: a real, tenant-scoped communication channel — see
  // docs/communications.md#channel-model. SMS/WhatsApp remain out of
  // scope.
  TELEGRAM
}

enum CommunicationPurpose {
  // The only purpose Phase 4 implements — mirrors ActionType.SEND_PAYMENT_REMINDER.
  PAYMENT_REMINDER
}

/// DRAFT -> SENDING -> SENT | FAILED | UNCERTAIN, plus FAILED/UNCERTAIN ->
/// SENDING on retry. See docs/communications.md#state-machine for the
/// full transition table and src/server/communications/send.ts for the
/// atomic compare-and-swap that enforces it (same technique as
/// src/server/operator/approval.ts's PENDING -> APPROVED/DISMISSED fix).
enum CommunicationStatus {
  DRAFT
  SENDING
  SENT
  FAILED
  // A dispatch attempt's outcome could not be confirmed either way (our
  // own timeout, a network error, or a process crash mid-attempt — see
  // docs/communications.md#unknown-outcomes). Never auto-retried.
  UNCERTAIN
}

/// A single logical communication with a customer — currently always one
/// email drafted for exactly one approved SEND_PAYMENT_REMINDER proposal
/// (`@@unique` on actionProposalId). `recipient`/`subject`/`body` are
/// snapshotted here, not read live from Customer at send time: once
/// dispatch starts (status leaves DRAFT) they are immutable, so what the
/// user reviewed is provably what was — or was attempted to be — sent.
model Communication {
  id               String               @id @default(cuid())
  organizationId   String
  customerId       String
  invoiceId        String
  actionProposalId String               @unique
  channel          CommunicationChannel @default(EMAIL)
  purpose          CommunicationPurpose
  recipient        String
  subject          String
  body             String
  status           CommunicationStatus  @default(DRAFT)
  aiGenerated      Boolean              @default(false)
  aiProvider       String?
  sentAt           DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice          Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  actionProposal   ActionProposal    @relation(fields: [actionProposalId], references: [id], onDelete: Restrict)
  deliveryAttempts DeliveryAttempt[]

  @@index([organizationId, status])
  @@index([customerId])
  @@index([invoiceId])
  @@map("communications")
}

enum DeliveryAttemptStatus {
  // Set the instant an attempt is claimed, before the provider call is
  // made. A row stuck here (no terminal status ever recorded) means the
  // process died mid-attempt — see docs/communications.md#unknown-outcomes;
  // the UI treats it exactly like UNCERTAIN.
  PENDING
  SUCCESS
  FAILED
  // The provider call itself did not resolve with a definite outcome
  // (timeout, network error, or any error the provider adapter didn't
  // classify as a definite rejection) — see EmailProviderRejectedError
  // vs. everything else in src/server/email/errors.ts.
  UNKNOWN
}

enum DeliveryFailureCategory {
  CONFIGURATION
  VALIDATION
  PROVIDER_REJECTED
  TRANSIENT_PROVIDER_ERROR
  TIMEOUT_OR_UNKNOWN
}

/// One row per actual dispatch attempt (initial send or retry) — never
/// mutated after it reaches a terminal status, so the full attempt
/// history survives regardless of how many times a communication is
/// retried. `idempotencyKey` is passed to the EmailProvider for adapters
/// that support provider-side deduplication (most don't — see
/// docs/communications.md#delivery-semantics for why the real duplicate
/// protection here is the DB-level compare-and-swap on Communication.status,
/// not this key).
model DeliveryAttempt {
  id                String                   @id @default(cuid())
  organizationId    String
  communicationId   String
  attemptNumber     Int
  provider          String
  idempotencyKey    String                   @unique
  status            DeliveryAttemptStatus    @default(PENDING)
  failureCategory   DeliveryFailureCategory?
  failureMessage    String?
  providerMessageId String?
  startedAt         DateTime                 @default(now())
  completedAt       DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@unique([communicationId, attemptNumber])
  @@index([organizationId])
  @@index([communicationId])
  @@map("delivery_attempts")
}

// --- Phase 5: Collections Automation -------------------------------------
// A CollectionPolicy is a tenant-scoped, OWNER-configured set of ordered
// steps ("N days after due, send a reminder with tone X"). It is not a
// visual workflow builder — steps are a flat, deterministic list. See
// docs/collections-automation.md for the full design.

enum CollectionAutomationMode {
  // Detect -> schedule -> prepare an ActionProposal/Communication draft; a
  // human must still approve and send via the existing Phase 3/4 flow.
  APPROVAL_REQUIRED
  // The engine itself approves the proposal and calls sendCommunication()
  // for allowlisted, transactional actions only. OFF by default; OWNER-only
  // opt-in per policy — see CollectionPolicy.autoSendEnabledByUserId.
  AUTO_SEND
}

enum CollectionStepAction {
  SEND_PAYMENT_REMINDER
  NOTIFY_OWNER
}

enum ReminderTone {
  SOFT
  STANDARD
  FIRM
}

/// Editing a policy's steps never retroactively changes an in-flight
/// CollectionSequence: steps are versioned (`currentVersion` +
/// CollectionPolicyStep.version), and a sequence locks in the version it
/// was enrolled under (CollectionSequence.policyVersion). Updating steps
/// bumps `currentVersion` and writes a new set of CollectionPolicyStep rows
/// at that version rather than mutating existing ones — old versions are
/// kept (never deleted) so already-running sequences keep working.
model CollectionPolicy {
  id                      String                   @id @default(cuid())
  organizationId          String
  name                    String
  isDefault               Boolean                  @default(false)
  // Master per-policy switch. A policy can exist, be fully configured, and
  // still never fire anything until this is true AND
  // Organization.automationEnabled is true — two independent switches, both
  // required, matching the org-level-vs-policy-level kill switch design.
  enabled                 Boolean                  @default(false)
  automationMode          CollectionAutomationMode @default(APPROVAL_REQUIRED)
  currentVersion          Int                      @default(1)
  // Set (OWNER-only) at the moment automationMode is switched to AUTO_SEND,
  // and used as the acting userId for the automatic approveActionProposal/
  // sendCommunication calls the engine performs on that path — an
  // auditable answer to "who authorized this send", never a null/system
  // sentinel. Cleared if the policy is switched back to APPROVAL_REQUIRED.
  autoSendEnabledByUserId String?
  autoSendEnabledAt       DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  autoSendEnabledByUser User?                  @relation(fields: [autoSendEnabledByUserId], references: [id], onDelete: SetNull)
  steps                 CollectionPolicyStep[]
  sequences             CollectionSequence[]

  @@index([organizationId])
  @@index([organizationId, isDefault])
  @@map("collection_policies")
}

/// One row per (policyId, version, stepOrder). `daysAfterDue` is the only
/// scheduling input — no raw cron expressions are ever accepted from a
/// client. Both uniques below reject a step configuration that couldn't be
/// executed deterministically (two steps firing on the same day, or two
/// steps claiming the same position).
model CollectionPolicyStep {
  id           String               @id @default(cuid())
  policyId     String
  version      Int
  stepOrder    Int
  daysAfterDue Int
  action       CollectionStepAction
  tone         ReminderTone         @default(STANDARD)
  createdAt    DateTime             @default(now())

  policy         CollectionPolicy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  stepExecutions CollectionStepExecution[]

  @@unique([policyId, version, stepOrder])
  @@unique([policyId, version, daysAfterDue])
  @@index([policyId, version])
  @@map("collection_policy_steps")
}

/// ACTIVE -> PAUSED -> ACTIVE (resume), ACTIVE -> COMPLETED (paid in full),
/// ACTIVE -> STOPPED (cancelled/manual/policy or automation disabled/customer
/// archived). See docs/collections-automation.md#sequence-lifecycle for the
/// full transition table.
enum CollectionSequenceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
}

enum CollectionStopReason {
  PAID
  CANCELLED
  MANUAL
  POLICY_DISABLED
  AUTOMATION_DISABLED
  CUSTOMER_ARCHIVED
}

/// The runtime instance of a policy applied to one invoice — decoupled from
/// the (mutable) CollectionPolicy via the `policyVersion` snapshot taken at
/// enrollment. `@@unique([organizationId, invoiceId])` makes enrollment
/// naturally idempotent: re-enrolling an already-enrolled invoice finds the
/// existing row instead of creating a duplicate (the same create-then-
/// catch-P2002 pattern used throughout Phases 3-4).
model CollectionSequence {
  id             String                   @id @default(cuid())
  organizationId String
  invoiceId      String
  customerId     String
  policyId       String
  policyVersion  Int
  status         CollectionSequenceStatus @default(ACTIVE)
  stopReason     CollectionStopReason?
  pausedAt       DateTime?
  completedAt    DateTime?
  stoppedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer       Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  policy         CollectionPolicy          @relation(fields: [policyId], references: [id], onDelete: Restrict)
  stepExecutions CollectionStepExecution[]

  @@unique([organizationId, invoiceId])
  @@index([organizationId, status])
  @@map("collection_sequences")
}

enum CollectionStepExecutionStatus {
  // Claimed by a worker via the unique constraint below, before the
  // eligibility re-check and any BusinessEvent/proposal creation. A row
  // stuck here (process died between claim and EXECUTED/SKIPPED) blocks
  // that exact step from ever being reclaimed — the same accepted,
  // human-resolvable tradeoff as a stuck Communication.SENDING row. See
  // docs/collections-automation.md#crash-recovery.
  CLAIMED
  // The step's BusinessEvent/OperatorInsight/ActionProposal (and, on
  // AUTO_SEND, Communication) were created. Distinct from
  // ActionProposal.EXECUTED, which specifically means "delivery confirmed
  // sent" — this means "the deterministic step logic ran".
  EXECUTED
  // Superseded by a later, more-advanced due step in the same catch-up
  // pass, or bypassed because the sequence's eligibility re-check failed
  // (invoice paid/cancelled, customer archived, automation disabled, ...).
  SKIPPED
}

/// The DB-backed invariant that makes one logical collection step of one
/// invoice impossible to execute twice, even under two concurrent workers:
/// `@@unique([sequenceId, stepId])` turns the claim into a plain INSERT
/// race (create, catch P2002, treat as already-claimed) rather than a
/// row-lock or in-memory mutex — see docs/collections-automation.md#concurrency.
model CollectionStepExecution {
  id               String                        @id @default(cuid())
  organizationId   String
  sequenceId       String
  stepId           String
  status           CollectionStepExecutionStatus @default(CLAIMED)
  businessEventId  String?                       @unique
  actionProposalId String?                       @unique
  note             String?
  claimedAt        DateTime                      @default(now())
  completedAt      DateTime?

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sequence       CollectionSequence   @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  step           CollectionPolicyStep @relation(fields: [stepId], references: [id], onDelete: Restrict)
  businessEvent  BusinessEvent?       @relation(fields: [businessEventId], references: [id], onDelete: SetNull)
  actionProposal ActionProposal?      @relation(fields: [actionProposalId], references: [id], onDelete: SetNull)

  @@unique([sequenceId, stepId])
  @@index([organizationId])
  @@index([sequenceId])
  @@map("collection_step_executions")
}

// --- Phase 9: Production Hardening ---------------------------------------
// Rate limiting and automation observability infrastructure — see
// docs/audits/PAYNORA-AUDIT-V1-REMEDIATION.md (P0-1, P1-4, P1-5, P1-7).

/// A durable, multi-instance-safe fixed-window rate-limit counter —
/// deliberately Postgres-backed rather than in-process memory, since an
/// in-memory counter means nothing once more than one server process
/// exists (serverless, or more than one long-lived instance behind a load
/// balancer) — see src/server/rate-limit/service.ts and
/// docs/audits/PAYNORA-AUDIT-V1-REMEDIATION.md P0-1. `(scope, key,
/// windowStart)` is the whole design: an atomic Postgres upsert
/// (`INSERT ... ON CONFLICT DO UPDATE ... RETURNING`) is what makes
/// concurrent requests unable to trivially race past the limit, not
/// application-level locking.
model RateLimitCounter {
  id          String   @id @default(cuid())
  scope       String
  key         String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([scope, key, windowStart])
  @@index([scope, key])
  @@map("rate_limit_counters")
}

/// One row per `runAutomationTick` invocation — the durable heartbeat a
/// health/status endpoint reads from, so "is automation actually running"
/// is answerable from persisted state, not just a log line that requires
/// someone to be watching. Deliberately contains no customer data, message
/// content, or provider secrets — only counts and a duration, safe to
/// expose through an operational status surface. See
/// src/server/collections/health.ts and
/// docs/audits/PAYNORA-AUDIT-V1-REMEDIATION.md P1-4.
model AutomationTickRun {
  id                     String    @id @default(cuid())
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  durationMs             Int?
  globallyDisabled       Boolean   @default(false)
  organizationsProcessed Int       @default(0)
  organizationsRemaining Int       @default(0)
  scanned                Int       @default(0)
  enrolled               Int       @default(0)
  claimed                Int       @default(0)
  executed               Int       @default(0)
  skipped                Int       @default(0)
  stopped                Int       @default(0)
  blocked                Int       @default(0)
  failed                 Int       @default(0)
  crashed                Boolean   @default(false)
  errorMessage           String?

  @@index([startedAt])
  @@map("automation_tick_runs")
}

// --- Phase 13: Wallet Foundation & Crypto Payments -----------------------
// See docs/wallet-architecture.md for the full design (ownership model,
// provider abstraction, transaction state machine, reconciliation rules,
// webhook pipeline, and documented financial-ambiguity decisions). No
// private key, seed phrase, or signing secret is ever stored by this
// schema — a Wallet row is an *address* PAYNORA is told to watch, never a
// credential PAYNORA holds. `network`/`asset` are free-string columns
// (like Customer.telegramChatId and OrganizationSubscription.billingProvider)
// validated against an allowlist at the domain layer
// (src/server/wallet/network.ts) rather than a Prisma enum, so recognizing
// a new chain or token never requires a migration — the same reasoning as
// Currency (src/server/ar/currency.ts).

enum WalletStatus {
  // Connected but ownership not yet verified by the provider — see
  // WalletProvider.verifyOwnership in src/server/wallet/provider-types.ts.
  PENDING_VERIFICATION
  ACTIVE
  // Terminal. A "reconnected" wallet is a new row, not a resurrected one —
  // same precedent as CollectionSequence.STOPPED — so history of who was
  // connected when is never silently overwritten.
  DISCONNECTED
}

/// A blockchain address PAYNORA has been told to watch for one organization
/// — an identifier, never a credential. `@@unique([network, address])` is
/// deliberately global, not organization-scoped: unlike every other unique
/// constraint in this schema, a real on-chain address is one external fact
/// shared by nobody else, not PAYNORA-issued data that could legitimately
/// repeat per tenant — this is also what makes cross-tenant transaction
/// misattribution structurally impossible (see
/// docs/wallet-architecture.md#tenant-isolation).
model Wallet {
  id               String       @id @default(cuid())
  organizationId   String
  network          String
  address          String
  label            String?
  // Provider-neutral vendor name ("test" in this phase; future:
  // "coinbase", "privy", ...) — mirrors
  // OrganizationSubscription.billingProvider's discipline of staying a
  // plain string, never a vendor-typed column.
  providerName     String
  // Opaque provider-assigned id for this connection, if the provider has
  // one. Never a secret — an API key or signing credential must never be
  // stored here or anywhere in this schema; see
  // docs/wallet-architecture.md#security-model.
  providerWalletId String?
  status           WalletStatus @default(PENDING_VERIFICATION)
  connectedAt      DateTime?
  disconnectedAt   DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentRequests CryptoPaymentRequest[]
  transactions    WalletTransaction[]

  @@unique([network, address])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("wallets")
}

enum CryptoPaymentRequestStatus {
  OPEN
  // Set the instant a WalletTransaction is matched and its Payment is
  // recorded — see reconcileWalletTransaction. Terminal.
  FULFILLED
  CANCELLED
  EXPIRED
}

/// The pre-registered expectation that lets reconciliation match an
/// anonymous on-chain event back to a specific invoice — blockchain
/// transactions carry no PAYNORA invoice id, so without this row a
/// received transaction has nothing to be reconciled against (see
/// docs/wallet-architecture.md#reconciliation). `requestedAmountMinor` is
/// the fiat amount (in the invoice's own currency) this request settles on
/// success; `expectedAssetAmountMinor` is the crypto amount, in the
/// asset's own smallest unit, that was quoted for it. The exchange rate
/// between the two is fixed at creation time by whoever creates the
/// request — this phase has no live FX-rate provider, so that rate is a
/// deliberate, documented manual input, never computed here. See
/// docs/wallet-architecture.md#known-limitations.
model CryptoPaymentRequest {
  id                       String                     @id @default(cuid())
  organizationId           String
  invoiceId                String
  walletId                 String
  network                  String
  asset                    String
  assetDecimals            Int
  expectedAssetAmountMinor BigInt
  requestedAmountMinor     BigInt
  status                   CryptoPaymentRequestStatus @default(OPEN)
  createdByUserId          String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice       Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  wallet        Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  createdByUser User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  transactions  WalletTransaction[]

  @@index([organizationId])
  // Backs reconcileWalletTransaction's FIFO "oldest open request for this
  // wallet+network+asset" match query — see
  // docs/wallet-architecture.md#reconciliation.
  @@index([walletId, network, asset, status, createdAt])
  @@index([invoiceId])
  @@map("crypto_payment_requests")
}

enum WalletTransactionDirection {
  INCOMING
  OUTGOING
}

/// DETECTED -> CONFIRMING -> CONFIRMED, with FAILED/EXPIRED as failure
/// paths — derived from the actual requirement (only a CONFIRMED,
/// INCOMING transaction may ever be reconciled into a Payment), not copied
/// from a generic template. No PENDING state: a webhook-observed event is
/// either still awaiting its first confirmation (DETECTED) or already has
/// one (CONFIRMING) — an extra intermediate state added nothing. See
/// docs/wallet-architecture.md#transaction-state-machine for the full
/// transition table and src/server/wallet/transaction-state-machine.ts for
/// the code that enforces it (illegal transitions are rejected, never
/// silently applied).
enum WalletTransactionStatus {
  DETECTED
  CONFIRMING
  CONFIRMED
  FAILED
  EXPIRED
}

enum ReconciliationOutcome {
  MATCHED
  // Never automatically reconciled into a Payment — see
  // reconciliationRejectionReason. Not necessarily an error: e.g. UNDERPAID
  // means a human must decide, not that anything is invalid.
  REJECTED
}

/// See docs/wallet-architecture.md#reconciliation for the exact rule
/// behind each value. NO_MATCHING_WALLET and NO_OPEN_PAYMENT_REQUEST
/// together cover "wrong network"/"wrong asset"/"wrong destination" from
/// the phase brief — network is part of Wallet's own unique key and
/// asset/network are part of the open-request match key, so a transaction
/// that's wrong on any of those axes simply fails to find a match rather
/// than needing its own separate rejection reason. Duplicate transactions
/// are prevented at ingestion (WalletTransaction.@@unique([network,
/// txHash])), not at reconciliation — a duplicate can never reach this
/// enum because it can never become a second row.
enum ReconciliationRejectionReason {
  NO_MATCHING_WALLET
  NO_OPEN_PAYMENT_REQUEST
  // The matched invoice's outstanding balance was already zero by the
  // time this transaction was reconciled (e.g. paid another way in the
  // meantime) — never creates a zero/negative Payment.
  INVOICE_ALREADY_SETTLED
  // Received asset amount is below the matched request's
  // expectedAssetAmountMinor. Deliberately never auto-converted into a
  // partial fiat Payment — see docs/wallet-architecture.md#underpayment
  // for why that would require inventing an exchange rate PAYNORA does
  // not have. The request stays OPEN; a human may record a manual payment
  // via the existing payment form, exactly as they would for a short bank
  // wire today.
  UNDERPAID
  TRANSACTION_FAILED
}

/// One row per real on-chain event, independent of any specific provider —
/// see WalletProvider.verifyAndParseWebhookEvent
/// (src/server/wallet/provider-types.ts), the only place a raw provider
/// payload is turned into this shape. `@@unique([network, txHash])` is the
/// core idempotency guarantee required by the phase brief: a repeated
/// webhook delivery for the same on-chain transaction always resolves to
/// this same row (create-or-find, same precedent as
/// BusinessEvent.@@unique/Payment.@@unique) — a duplicate financial record
/// is structurally impossible, not just discouraged. `amountMinor` is the
/// asset's own smallest unit (see `assetDecimals`), never a float — same
/// bigint discipline as Invoice/Payment.amountMinor. This model
/// deliberately does NOT duplicate the fiat Payment model — see
/// docs/wallet-architecture.md#transaction-vs-payment for the boundary;
/// `reconciledPaymentId` is the one link between the two, set only once
/// reconciliation actually creates a Payment.
model WalletTransaction {
  id                            String                         @id @default(cuid())
  organizationId                String
  walletId                      String
  network                       String
  txHash                        String
  direction                     WalletTransactionDirection
  asset                         String
  assetDecimals                 Int
  amountMinor                   BigInt
  fromAddress                   String?
  toAddress                     String
  status                        WalletTransactionStatus        @default(DETECTED)
  confirmations                 Int                            @default(0)
  requiredConfirmations         Int                            @default(1)
  detectedAt                    DateTime                       @default(now())
  confirmedAt                   DateTime?
  failureReason                 String?
  providerName                  String
  providerEventId               String?
  matchedRequestId              String?
  reconciliationOutcome         ReconciliationOutcome?
  reconciliationRejectionReason ReconciliationRejectionReason?
  reconciledPaymentId           String?                        @unique
  // Safe, non-secret provider metadata only (e.g. block number, gas fee) —
  // never a private key, signing secret, or raw Authorization header. See
  // docs/wallet-architecture.md#security-model.
  metadata                      Json?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wallet            Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  matchedRequest    CryptoPaymentRequest? @relation(fields: [matchedRequestId], references: [id], onDelete: SetNull)
  reconciledPayment Payment?              @relation(fields: [reconciledPaymentId], references: [id], onDelete: SetNull)

  // Deliberately global, not organization-scoped — see the model doc
  // comment above and docs/wallet-architecture.md#tenant-isolation.
  @@unique([network, txHash])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([walletId])
  @@map("wallet_transactions")
}
