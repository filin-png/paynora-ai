# PAYNORA AI — environment variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# From Phase 1 onward, DATABASE_URL and AUTH_SECRET are required — the app
# won't start without them. Both are free and local; see DEPLOYMENT.md.

# Node environment. Next.js sets this automatically; you rarely need to set
# it yourself.
# NODE_ENV=development

# PostgreSQL connection string, required. The value below matches
# docker-compose.yml (`docker compose up -d postgres`) — it is a local
# development default, not a secret. Any local Postgres works identically;
# see DEPLOYMENT.md.
DATABASE_URL=postgresql://paynora:paynora@localhost:5432/paynora?schema=public

# Maximum number of Postgres connections this one process's pool may open
# (node-postgres's own default is 10). Only meaningful under the
# supported production hosting model — a long-lived Node.js process with
# one pool for its lifetime; see
# DEPLOYMENT.md#production-hosting-model. Optional, defaults to 10.
# DATABASE_POOL_MAX=10

# Signs and encrypts session cookies (Auth.js). Required, at least 32
# characters, no default provided on purpose — see SECURITY.md on why a
# missing security secret should fail loudly rather than fall back to
# something insecure. Generate your own locally:
#   openssl rand -base64 33
AUTH_SECRET=

# Selects the active AIProvider implementation (see docs/ai-integration.md
# and, since Phase 6, docs/integration-architecture.md#ai-routing).
# "none" (default) disables AI features without breaking the app.
# One of: none | gigachat | yandex | openrouter | mistral
# "gigachat"/"yandex" are recognized but not implemented yet — selecting
# either fails loudly with a clear error, never a silent no-op.
# Phase 21A: Mistral is PAYNORA's primary production AI provider — see
# docs/ai-integration.md. OpenRouter remains implemented (Phase 6) but is
# not the recommended default; nothing in this deployment requires it.
# AI_PROVIDER=none

# Optional single fallback provider, tried only if AI_PROVIDER's attempt
# fails — never a longer chain, never retried past one confirmed success.
# Must differ from AI_PROVIDER. Same allowed values as AI_PROVIDER except
# "none". See docs/integration-architecture.md#ai-routing.
# AI_PROVIDER_FALLBACK=

# Required once AI_PROVIDER or AI_PROVIDER_FALLBACK is "openrouter". Real
# adapter, mocked-network tested — see
# src/server/ai/providers/openrouter.test.ts. Never logged, never sent to
# the client.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Required once AI_PROVIDER or AI_PROVIDER_FALLBACK is "mistral" — PAYNORA's
# primary production AI provider as of Phase 21A. Same shape as
# OPENROUTER_* above — see src/server/ai/providers/mistral.test.ts and
# docs/ai-integration.md. Get MISTRAL_API_KEY from https://console.mistral.ai/
# (La Plateforme — "API Keys"). NEVER commit a real value here.
# MISTRAL_API_KEY=
# MISTRAL_MODEL is not defaulted in code (never hardcode a vendor model in
# business logic) — set it explicitly to a real, currently-supported Mistral
# model id. Per Mistral's own model-picking guidance, "mistral-small-latest"
# is the sensible default for this codebase's AI-assisted tasks (short
# reminder-email wording, insight summaries, explanations — not heavy
# reasoning or code); "mistral-large-latest" is available for a higher-
# quality/higher-cost alternative. Verify current model names at
# https://docs.mistral.ai/getting-started/models/ before deploying, since
# vendor model names/aliases change over time.
# MISTRAL_MODEL=mistral-small-latest

# Phase 11.2: base URL used to build password-reset and organization-
# invitation links embedded in transactional emails. Defaults to the local
# dev server — a real deployment must set this to its actual public origin,
# or every emailed link will point at localhost.
# APP_BASE_URL=http://localhost:3000

# Selects the active EmailProvider implementation (see docs/communications.md).
# "none" (default) disables actually sending email — drafting, preview, and
# editing a reminder still work; only the explicit Send action is
# unavailable, with a clear configuration error rather than a fake success.
# EMAIL_PROVIDER=none

# Required once EMAIL_PROVIDER is not "none". The sender address for every
# outgoing email — never user-supplied per-message, see
# docs/communications.md#sender-safety.
# PAYNORA_EMAIL_FROM=billing@yourcompany.example

# Optional. Where a submitted Support Request's best-effort notification
# email goes (Settings -> General -> "Contact support"). If unset, a
# request is still saved and audited — just with no outbound email.
# SUPPORT_NOTIFICATION_EMAIL=founder@yourcompany.example

# Required once EMAIL_PROVIDER=smtp. Works with any SMTP relay — a
# self-hosted mail server, a Russia-accessible provider, or a foreign one —
# nothing here is vendor-specific; see docs/communications.md#provider-abstraction.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# Deployment-level kill switch for Phase 5 collections automation (see
# docs/collections-automation.md#kill-switch). Defaults to "false": even if
# an organization has enabled automation in its own settings, the automation
# tick does nothing external unless this is explicitly "true" too — two
# independent switches, both required, before anything is ever sent
# automatically.
# AUTOMATION_ENABLED=false

# Required once AUTOMATION_ENABLED=true. Bearer secret the internal
# scheduler endpoint (POST /internal/automation/tick) requires in an
# Authorization header — never accepted from a normal user session, never
# logged. Generate your own locally:
#   openssl rand -base64 24
# AUTOMATION_CRON_SECRET=

# Maximum number of organizations one automation tick invocation
# processes before returning (see docs/collections-automation.md) — bounds
# per-invocation work so a large number of organizations can't make a
# single tick run unboundedly long. Any organizations beyond this batch
# are picked up by the next tick via a persisted cursor, not skipped.
# Optional, defaults to 20.
# AUTOMATION_BATCH_SIZE=20

# Hourly per-organization limits on real provider-cost/abuse-prone
# actions (see docs/audits/PAYNORA-AUDIT-V1-REMEDIATION.md P1-7) — how
# much AI/send/operator-run volume is normal genuinely varies by
# deployment, so these are configurable rather than hardcoded. All
# optional; defaults shown.
# RATE_LIMIT_AI_GENERATION_PER_HOUR=50
# RATE_LIMIT_COMMUNICATION_SEND_PER_HOUR=100
# RATE_LIMIT_OPERATOR_RUN_PER_HOUR=20

# Selects the active MessagingProvider implementation (see
# docs/integration-architecture.md#messaging). "none" (default) disables
# messaging entirely. One of: none | telegram. Since Phase 8, this is a
# real second communication channel alongside Email — a customer needs a
# Telegram chat id on file (and, if both channels are configured, an
# explicit preferred channel) before a reminder can be sent there; see
# docs/communications.md#channel-model.
# MESSAGING_PROVIDER=none

# Required once MESSAGING_PROVIDER=telegram. The bot token from
# @BotFather. Real adapter, mocked-network tested — see
# src/server/messaging/providers/telegram.test.ts. Never logged (the
# adapter's own error paths deliberately never include the request URL,
# which embeds this token).
# TELEGRAM_BOT_TOKEN=

# Selects the active BillingProvider implementation for PAYNORA's own
# subscription billing (see docs/billing-provider.md) — distinct from
# AR/collections (invoices your customers pay you). "none" (default)
# disables real checkout entirely. One of: none | stripe | yookassa.
# "stripe" is recognized but not implemented yet (fails loudly with a
# clear error if selected) — "yookassa" has a real adapter as of Phase 20.
# BILLING_PROVIDER=none

# Required once BILLING_PROVIDER=yookassa — see
# docs/billing-provider.md#environment-configuration. Get these from your
# YooKassa merchant dashboard (https://yookassa.ru/my/, "Integration" ->
# "API keys"). YUKASSA_SHOP_ID is your shop's numeric id; YUKASSA_SECRET_KEY
# is the "Live" (or "Test") secret key — NEVER commit a real value here.
# YUKASSA_SHOP_ID=
# YUKASSA_SECRET_KEY=

# Optional. YooKassa verifies webhook authenticity by source-IP allowlist,
# not a signature (see src/server/billing/providers/yookassa.ts's own doc
# comment) — the adapter ships with the IP ranges from YooKassa's own
# published documentation as of Phase 20. Set this (comma-separated CIDR
# blocks) only to override that built-in list, e.g. if YooKassa publishes
# new ranges before this codebase is updated. Verify the current list at
# https://yookassa.ru/developers/using-api/webhooks before relying on
# either the built-in default or a value you set here.
# YUKASSA_WEBHOOK_IP_ALLOWLIST=

# Purely descriptive metadata (see
# docs/integration-architecture.md#deployment-profiles) — labels which
# vendor set this deployment is expected to run, for documentation and a
# future setup UI. Never enforced: selecting a vendor outside its
# profile's recommendation is never rejected. One of: RU | GLOBAL |
# LOCAL_TEST. Defaults to LOCAL_TEST.
# DEPLOYMENT_PROFILE=LOCAL_TEST

# Only read by `npm run test` (see vitest.config.mts), never by the app.
# Points integration tests at a separate database so they can freely
# truncate tables between runs without touching dev data. Defaults to
# paynora_test on the same local Postgres if unset.
# TEST_DATABASE_URL=postgresql://paynora:paynora@localhost:5432/paynora_test?schema=public

# --- WALLET (Phase 13 foundation, Phase 14 real adapter) -------------------
# See docs/wallet-architecture.md and docs/production-integrations.md#wallet.
# Selects the active WalletProvider implementation. "none" (default)
# disables crypto payments entirely — the wallet UI shows an honest
# "not connected" state. One of: none | alchemy | coinbase | privy.
# "coinbase"/"privy" are recognized but not implemented yet.
# WALLET_PROVIDER=none

# Required once WALLET_PROVIDER=alchemy — three distinct credentials for
# three distinct Alchemy surfaces (see src/server/wallet/providers/alchemy.ts):
# ALCHEMY_API_KEY authenticates JSON-RPC/Enhanced API calls (balances,
# transaction lookups); ALCHEMY_AUTH_TOKEN authenticates the Notify
# (webhook-management) API; ALCHEMY_WEBHOOK_ID is a pre-created Address
# Activity webhook's id (create it once in the Alchemy dashboard, pointed
# at https://<your-domain>/api/webhooks/wallet/<org-slug>); ALCHEMY_WEBHOOK_SIGNING_KEY
# is that webhook's own per-webhook HMAC signing key, shown once when it's created.
# ALCHEMY_API_KEY=
# ALCHEMY_AUTH_TOKEN=
# ALCHEMY_WEBHOOK_ID=
# ALCHEMY_WEBHOOK_SIGNING_KEY=

# Wallet-domain rate limit — see docs/wallet-architecture.md.
# RATE_LIMIT_WEB_SEARCH_PER_HOUR is documented below (web search section);
# there is no separate wallet-specific rate limit env var in this phase —
# reconciliation/ingestion volume is bounded by real on-chain event rate,
# not a configurable knob.

# --- ANALYTICS (Phase 14) ---------------------------------------------------
# See docs/production-integrations.md#analytics. Selects the active
# AnalyticsProvider. "none" (default) is a real, harmless no-op — nothing
# is ever sent anywhere. One of: none | posthog.
# ANALYTICS_PROVIDER=none

# Required once ANALYTICS_PROVIDER=posthog. Project API key from your
# PostHog project settings (Project Settings -> Project API Key).
# ANALYTICS_PROVIDER=posthog
# POSTHOG_API_KEY=

# PostHog ingestion host. Defaults to the US cloud; use
# https://eu.i.posthog.com for EU-hosted data residency — see
# docs/production-integrations.md#european-access.
# POSTHOG_HOST=https://us.i.posthog.com

# --- WEB SEARCH (Phase 14) --------------------------------------------------
# See docs/production-integrations.md#web-intelligence. Selects the active
# WebSearchProvider — deliberately separate from AI_PROVIDER. "none"
# (default) disables web search entirely. One of: none | anthropic | yandex.
# "yandex" is recognized but not implemented yet.
# WEB_SEARCH_PROVIDER=none

# Required once WEB_SEARCH_PROVIDER=anthropic. A real Anthropic API key
# with web search enabled for the organization (Claude Console -> Settings
# -> Privacy). This is a separate Anthropic account/key from any AI
# provider you may also use for PAYNORA's own Operator/Copilot features —
# AI_PROVIDER never selects "anthropic" in this codebase.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Hourly cap on real web searches per organization — each search is a
# billed vendor call ($10/1,000 on the Anthropic adapter) in addition to
# token costs. See docs/production-integrations.md#cost-control.
# RATE_LIMIT_WEB_SEARCH_PER_HOUR=20
