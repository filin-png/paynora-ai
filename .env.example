# PAYNORA AI — environment variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Nothing in this file is required to run `npm run dev` in Phase 0.
# Variables become required as later phases introduce the features
# that need them (see ROADMAP.md).

# Node environment. Next.js sets this automatically; you rarely need to set
# it yourself.
# NODE_ENV=development

# PostgreSQL connection string. Not read by the app itself until Phase 1
# adds domain models, but the Prisma CLI (`npm run db:validate` /
# `db:generate`) needs it set even against an empty schema. The value below
# matches docker-compose.yml (`docker compose up -d postgres`) — it is a
# local development default, not a secret. Any local Postgres works
# identically; see DEPLOYMENT.md.
DATABASE_URL=postgresql://paynora:paynora@localhost:5432/paynora?schema=public

# Selects the active AIProvider implementation (see docs/ai-architecture.md).
# "none" (default) disables AI features without breaking the app.
# AI_PROVIDER=none
